# ============================================================
# AI Terminal 厂商接入模板：复制后填 Key 即可（默认智谱免费模型）
# Spring Boot 不会自动读取 .env，请将值设为系统环境变量，
# docker compose 会自动读取本文件。
# ============================================================

OPENAI_API_KEY=replace-with-your-zhipu-key
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4-flash

# ---------- 视觉与图片（可选，默认即智谱免费/低价的组合） ----------
#OPENAI_VISION_MODEL=glm-4.5v
#OPENAI_IMAGE_MODEL=cogview-3-flash

# ---------- 账号体系（生产必须覆盖 secret） ----------
#APP_AUTH_SECRET=换成32位以上的随机字符串
#APP_AUTH_TOKEN_HOURS=168

# ---------- 语音（可选，需在智谱控制台开通语音资源包） ----------
#OPENAI_ASR_MODEL=glm-asr
#OPENAI_TTS_MODEL=glm-tts
#OPENAI_TTS_VOICE=tongtong

# ---------- 各厂商预设（取消注释整段替换上面三项） ----------

# --- 智谱 AI（默认）：glm-4-flash 永久免费无上限，注册 https://open.bigmodel.cn ---
#OPENAI_API_KEY=你的智谱Key
#OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#OPENAI_MODEL=glm-4-flash

# --- DeepSeek：注册 https://platform.deepseek.com ---
#OPENAI_BASE_URL=https://api.deepseek.com
#OPENAI_MODEL=deepseek-chat

# --- 通义千问：注册 https://dashscope.console.aliyun.com/apiKey ---
#OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#OPENAI_MODEL=qwen-plus

# --- 硅基流动：送 2000 万 Token，https://siliconflow.cn ---
#OPENAI_BASE_URL=https://api.siliconflow.cn/v1
#OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- OpenAI 官方（无免费额度）---
#OPENAI_API_KEY=你的OpenAIKey
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_COMPLETIONS_PATH=/chat/completions
#OPENAI_MODEL=gpt-4o-mini

# --- 本地 Ollama（零成本）：先 ollama pull qwen2.5:7b ---
#OPENAI_BASE_URL=http://localhost:11434/v1
#OPENAI_API_KEY=ollama
#OPENAI_MODEL=qwen2.5:7b

# ---------- 邮箱验证码 / 找回密码（默认 QQ 邮箱，可选） ----------
# QQ 邮箱：设置 → 账户 → 开启 POP3/IMAP/SMTP 服务 → 生成授权码（不是 QQ 密码）
#APP_MAIL_ENABLED=true
#APP_MAIL_USERNAME=你的QQ号@qq.com
#APP_MAIL_PASSWORD=QQ邮箱授权码
#APP_MAIL_HOST=smtp.qq.com
#APP_MAIL_PORT=465
#APP_MAIL_SSL=true
# 本地联调：不发真实邮件，验证码打印到日志并回传接口（上线务必关闭）
#APP_MAIL_DEV_MODE=false
